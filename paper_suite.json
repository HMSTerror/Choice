        "baseline": {"dropout": 0.5, "bert_layers": 2, "bert_heads": 2, "bert_attention_dropout": 0.2, "bert_mask_probability": 0.6, "bert_max_length": 50, "bert_max_predictions": 30, "bert_dupe_factor": 10, "bert_eval_negatives": 100, "bert_eval_seed": 12345, "bert_evaluation": "bert_popularity_100", "bert_implementation": "official_615eaf2_pytorch_v2"},
        "datasets": {
          "Steam": {"hidden_size": 256, "training": {"decay_steps": 800000}, "baseline": {"dropout": 0.2, "bert_mask_probability": 0.4, "bert_max_predictions": 20, "bert_heads": 8}},
